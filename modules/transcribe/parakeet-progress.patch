+struct parakeet_progress {
+    bool * is_first;
+    bool print_progress;
+    int64_t total_ms;
+    int progress_prev;
+};
+
+static void encoder_progress_callback(parakeet_context *, parakeet_state *, int percent, void * user_data) {
+    auto * progress = (parakeet_progress *) user_data;
+    if (progress->print_progress) {
+        fprintf(stderr, "parakeet_encoder_print_progress_callback: progress = %3d%%\n", percent);
+        if (percent == 100) {
+            fprintf(stderr, "parakeet_print_progress_callback: progress =   0%%\n");
+        }
+    }
+}
