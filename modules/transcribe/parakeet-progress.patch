+// Observe only completed layer boundaries, retaining backend batching within
+// each layer. Layer count approximates work, not elapsed time or decoded audio.
+struct parakeet_encode_progress {
+    parakeet_context * ctx;
+    parakeet_state * state;
+    parakeet_progress_callback callback;
+    void * user_data;
+    int n_layers;
+};
+
+static bool parakeet_encode_eval(struct ggml_tensor * tensor, bool ask, void * user_data) {
+    auto * progress = (parakeet_encode_progress *) user_data;
+    int layer = -1;
+    int end = 0;
+    const char * name = ggml_get_name(tensor);
+    const bool boundary = sscanf(name, "enc_%d_ffn_res%n", &layer, &end) == 1
+        && end > 0 && name[end] == '\0' && layer >= 0 && layer < progress->n_layers;
+    if (ask) {
+        return boundary;
+    }
+    if (boundary) {
+        const int percent = std::min(99, (layer + 1) * 100 / progress->n_layers);
+        progress->callback(progress->ctx, progress->state, percent, progress->user_data);
+    }
+    return true;
+}
