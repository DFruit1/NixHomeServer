+    *progress->is_first = false;
+
+    if (progress->print_progress && progress->total_ms > 0) {
+        // t1 counts decoded 10 ms frames, so it is the real audio position.
+        int value = (int) (token_data->t1 * 1000 / progress->total_ms);
+        if (value > 100) {
+            value = 100;
+        }
+        if (value >= progress->progress_prev + 1) {
+            progress->progress_prev = value;
+            fprintf(stderr, "parakeet_print_progress_callback: progress = %3d%%\n", value);
+        }
+    }
 }

