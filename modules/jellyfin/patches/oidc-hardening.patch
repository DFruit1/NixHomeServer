diff --git a/Jellyfin.Plugin.OIDC/Services/OidcTokenValidator.cs b/Jellyfin.Plugin.OIDC/Services/OidcTokenValidator.cs
new file mode 100644
index 0000000..15908c5
--- /dev/null
+++ b/Jellyfin.Plugin.OIDC/Services/OidcTokenValidator.cs
@@ -0,0 +1,92 @@
+using System;
+using System.Collections.Generic;
+using System.IdentityModel.Tokens.Jwt;
+using System.Security.Claims;
+using System.Security.Cryptography;
+using System.Text;
+using System.Threading;
+using System.Threading.Tasks;
+using Microsoft.IdentityModel.Tokens;
+
+namespace Jellyfin.Plugin.OIDC.Services;
+
+public static class OidcTokenValidator
+{
+    private static readonly TimeSpan AllowedClockSkew = TimeSpan.FromMinutes(2);
+
+    public static async Task<ClaimsPrincipal> ValidateWithKeyRefreshAsync(
+        string identityToken,
+        string issuer,
+        string clientId,
+        IEnumerable<SecurityKey> signingKeys,
+        string expectedNonce,
+        Func<CancellationToken, Task<IEnumerable<SecurityKey>>> refreshSigningKeys,
+        CancellationToken cancellationToken)
+    {
+        try
+        {
+            return Validate(identityToken, issuer, clientId, signingKeys, expectedNonce);
+        }
+        catch (SecurityTokenSignatureKeyNotFoundException)
+        {
+            var refreshedKeys = await refreshSigningKeys(cancellationToken).ConfigureAwait(false);
+            return Validate(identityToken, issuer, clientId, refreshedKeys, expectedNonce);
+        }
+    }
+
+    public static ClaimsPrincipal Validate(
+        string identityToken,
+        string issuer,
+        string clientId,
+        IEnumerable<SecurityKey> signingKeys,
+        string expectedNonce)
+    {
+        if (string.IsNullOrWhiteSpace(identityToken))
+        {
+            throw new SecurityTokenException("The token endpoint did not return an ID token.");
+        }
+
+        var handler = new JwtSecurityTokenHandler
+        {
+            MapInboundClaims = false
+        };
+        var principal = handler.ValidateToken(
+            identityToken,
+            new TokenValidationParameters
+            {
+                ValidateIssuer = true,
+                ValidIssuer = issuer,
+                ValidateAudience = true,
+                ValidAudience = clientId,
+                RequireAudience = true,
+                ValidateLifetime = true,
+                RequireExpirationTime = true,
+                RequireSignedTokens = true,
+                ValidateIssuerSigningKey = true,
+                IssuerSigningKeys = signingKeys,
+                ClockSkew = AllowedClockSkew
+            },
+            out _);
+
+        var actualNonce = principal.FindFirst("nonce")?.Value;
+        if (!FixedTimeEquals(expectedNonce, actualNonce))
+        {
+            throw new SecurityTokenValidationException("The ID-token nonce did not match the authentication request.");
+        }
+
+        return principal;
+    }
+
+    private static bool FixedTimeEquals(string expected, string? actual)
+    {
+        if (string.IsNullOrEmpty(expected) || string.IsNullOrEmpty(actual))
+        {
+            return false;
+        }
+
+        var expectedBytes = Encoding.UTF8.GetBytes(expected);
+        var actualBytes = Encoding.UTF8.GetBytes(actual);
+        return expectedBytes.Length == actualBytes.Length
+            && CryptographicOperations.FixedTimeEquals(expectedBytes, actualBytes);
+    }
+}
