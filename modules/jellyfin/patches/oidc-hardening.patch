+    private async Task<ClaimsPrincipal> ValidateIdentityTokenAsync(
+        OidcProviderConfig provider,
+        DiscoveryDocumentResponse discovery,
+        string? identityToken,
+        string expectedNonce,
+        CancellationToken cancellationToken)
+    {
+        var issuer = discovery.Issuer
+            ?? throw new SecurityTokenException("OIDC discovery did not return an issuer.");
+        var signingKeys = await GetSigningKeysAsync(discovery, cancellationToken).ConfigureAwait(false);
+
+        return await OidcTokenValidator.ValidateWithKeyRefreshAsync(
+            identityToken ?? string.Empty,
+            issuer,
+            provider.ClientId,
+            signingKeys,
+            expectedNonce,
+            async token =>
+            {
+                _logger.LogInformation(
+                    "OIDC signing key was not found for provider {Provider}; refreshing discovery once",
+                    provider.ProviderId);
+                var refreshedDiscovery = await GetDiscoveryDocumentAsync(provider).ConfigureAwait(false);
+                if (refreshedDiscovery.IsError
+                    || !string.Equals(refreshedDiscovery.Issuer, issuer, StringComparison.Ordinal))
+                {
+                    throw new SecurityTokenException("OIDC discovery refresh failed or changed issuer.");
+                }
+
+                return await GetSigningKeysAsync(refreshedDiscovery, token).ConfigureAwait(false);
+            },
+            cancellationToken).ConfigureAwait(false);
+    }
+
+    private async Task<IEnumerable<SecurityKey>> GetSigningKeysAsync(
+        DiscoveryDocumentResponse discovery,
+        CancellationToken cancellationToken)
+    {
+        if (string.IsNullOrWhiteSpace(discovery.Issuer)
+            || !Uri.TryCreate(discovery.JwksUri, UriKind.Absolute, out var jwksUri)
+            || !string.Equals(jwksUri.Scheme, Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase))
+        {
+            throw new SecurityTokenException("OIDC discovery did not return a valid HTTPS JWKS endpoint.");
+        }
+
+        var httpClient = _httpClientFactory.CreateClient("OidcPlugin");
+        var jwksJson = await httpClient.GetStringAsync(jwksUri, cancellationToken).ConfigureAwait(false);
+        return JsonWebKeySet.Create(jwksJson).GetSigningKeys();
+    }
