set -euo pipefail

username="${1:-}"
if ! @NIX_GNUGREP@/bin/grep -Eq '^[a-z][a-z0-9._-]{0,63}$' <<<"$username"; then
  echo "invalid username" >&2
  exit 1
fi

public_key="$(@NIX_COREUTILS@/bin/cat | @NIX_COREUTILS@/bin/tr -d '\r' | @NIX_GNUSED@/bin/sed -e 's/[[:space:]]*$//')"
case "$public_key" in
  "ssh-ed25519 "*|"ssh-rsa "*|"ecdsa-sha2-nistp256 "*|"ecdsa-sha2-nistp384 "*|"ecdsa-sha2-nistp521 "*|"sk-ssh-ed25519@openssh.com "*|"sk-ecdsa-sha2-nistp256@openssh.com "*)
    ;;
  *)
    echo "invalid OpenSSH public key" >&2
    exit 1
    ;;
esac

if printf '%s' "$public_key" | @NIX_GNUGREP@/bin/grep -q '[[:cntrl:]]'; then
  echo "invalid control character in public key" >&2
  exit 1
fi

key_check="$(@NIX_COREUTILS@/bin/mktemp)"
trap '@NIX_COREUTILS@/bin/rm -f "$key_check"' EXIT
@NIX_COREUTILS@/bin/printf '%s\n' "$public_key" > "$key_check"
if ! @NIX_OPENSSH@/bin/ssh-keygen -l -f "$key_check" >/dev/null 2>&1; then
  echo "invalid or corrupted OpenSSH public key" >&2
  exit 1
fi
@NIX_COREUTILS@/bin/rm -f "$key_check"
trap - EXIT

@NIX_COREUTILS@/bin/install -d -m 0755 -o root -g root @NIX_SFTPAUTHORIZEDKEYSDIR_QUOTED@
exec 9>"@NIX_SFTPAUTHORIZEDKEYSDIR@/.$username.lock"
@NIX_UTIL_LINUX@/bin/flock -x 9

# The browser token can outlive a group change, and this helper is
# reachable by any homepage user (self-service) and by administrators
# (offboarding), so the target's eligibility must be re-verified against
# current Kanidm state under the same lock rather than trusted from the
# OAuth session that started the request. SFTP access is granted by
# membership in any of the SFTP access groups -- exactly the set the
# files-sftp-sshd AllowGroups line permits. Every lookup failure fails
# closed: no authorized-keys file is written.
#
# The helper receives only the target username; it has no independent
# channel to the acting identity, so this is a target-eligibility check,
# not proof of who is acting. See the task handoff for the residual
# service-account authority this leaves in a compromised homepage process.
identity_home="$(@NIX_COREUTILS@/bin/mktemp -d)"
trap '@NIX_COREUTILS@/bin/rm -rf "$identity_home"' EXIT
export HOME="$identity_home"
KANIDM_PASSWORD="$(< @NIX_CONFIG_AGE_SECRETS_KANIDMADMINPASS_PATH@)"
export KANIDM_PASSWORD
if ! @NIX_KANIDM_1_11@/bin/kanidm login \
  -H @NIX_KANIDM_URL_QUOTED@ \
  -D idm_admin >/dev/null; then
  echo "unable to verify current SFTP membership; no key was installed" >&2
  exit 1
fi
sftp_access_groups=@NIX_SFTP_ACCESS_GROUPS_QUOTED@
eligible=0
for group in $sftp_access_groups; do
  group_json="$(
    @NIX_KANIDM_1_11@/bin/kanidm group get "$group" \
      -H @NIX_KANIDM_URL_QUOTED@ \
      -D idm_admin \
      -o json
  )" || {
    echo "unable to verify current SFTP membership; no key was installed" >&2
    exit 1
  }
  # A well-formed group response answers the membership question through jq's
  # exit status: 0 for a match and 1 for an authoritative nonmatch. Any other
  # status -- unparseable JSON, an unexpected response shape, or any other jq
  # error -- is not an answer, so it refuses outright. Falling through to the
  # next group would let a malformed response be masked by a later match.
  #
  # The response shape is checked before the membership question is asked. A
  # group with no members legitimately omits the member attribute, which reads
  # as an empty membership list; a response without an attrs object is a
  # protocol surprise and refuses instead of reading as "no members".
  membership_status=0
  @NIX_JQ@/bin/jq -e --arg username "$username" '
      if type != "object" then
        error("group response is not a JSON object")
      elif (.attrs | type) != "object" then
        error("group response has no attrs object")
      elif ((.attrs.member // []) | type) != "array" then
        error("invalid member attribute")
      elif any(.attrs.member[]?; type != "string") then
        error("member array contains a non-string entry")
      else
        any(.attrs.member[]?;
          (split("@")[0] as $u
           | if ($u | test("^[a-z][a-z0-9._-]{0,63}$")) then
               $u
             else
               error("invalid local username in member entry")
             end) == $username)
      end
    ' <<<"$group_json" >/dev/null || membership_status=$?
  case "$membership_status" in
    0)
      eligible=1
      ;;
    1)
      : # authoritative nonmatch for this group
      ;;
    *)
      echo "unable to verify current SFTP membership; no key was installed" >&2
      exit 1
      ;;
  esac
  if (( eligible == 1 )); then
    break
  fi
done
if (( eligible != 1 )); then
  echo "current Kanidm membership does not permit SFTP access; no key was installed" >&2
  exit 1
fi
@NIX_COREUTILS@/bin/rm -rf "$identity_home"
trap - EXIT

target="@NIX_SFTPAUTHORIZEDKEYSDIR@/$username"
if [[ -L "$target" ]]; then
  echo "refusing symlinked authorized-keys file" >&2
  exit 1
fi
tmp="$(@NIX_COREUTILS@/bin/mktemp @NIX_SFTPAUTHORIZEDKEYSDIR_SERVICEUSER_XXXXXX_QUOTED@)"
trap 'rm -f "$tmp"' EXIT
if [[ -e "$target" ]]; then
  owner_group="$(@NIX_COREUTILS@/bin/stat -c '%U:%G' "$target")"
  mode="$(@NIX_COREUTILS@/bin/stat -c '%a' "$target")"
  if [[ "$owner_group" != "root:root" || "$mode" != "644" || ! -f "$target" ]]; then
    echo "existing authorized-keys file has unsafe ownership, mode, or type" >&2
    exit 1
  fi
  @NIX_COREUTILS@/bin/cat "$target" > "$tmp"
fi
if ! @NIX_GNUGREP@/bin/grep -Fqx -- "$public_key" "$tmp"; then
  key_count="$(@NIX_GNUGREP@/bin/grep -cve '^[[:space:]]*$' "$tmp" || true)"
  if (( key_count >= 10 )); then
    echo "at most 10 SFTP device keys may be registered; ask an administrator to retire an old key" >&2
    exit 1
  fi
  @NIX_COREUTILS@/bin/printf '%s\n' "$public_key" >> "$tmp"
fi
@NIX_COREUTILS@/bin/chown root:root "$tmp"
@NIX_COREUTILS@/bin/chmod 0644 "$tmp"
@NIX_COREUTILS@/bin/mv "$tmp" "$target"

if ! @NIX_GNUGREP@/bin/grep -Fqx -- "$public_key" "$target"; then
  echo "saved authorized-keys file does not contain submitted key" >&2
  exit 1
fi

owner_group="$(@NIX_COREUTILS@/bin/stat -c '%U:%G' "$target")"
mode="$(@NIX_COREUTILS@/bin/stat -c '%a' "$target")"
if [ "$owner_group" != "root:root" ] || [ "$mode" != "644" ]; then
  echo "saved public key has incorrect ownership or mode: $owner_group $mode" >&2
  exit 1
fi

key_count="$(@NIX_GNUGREP@/bin/grep -cve '^[[:space:]]*$' "$target")"
@NIX_COREUTILS@/bin/printf 'saved %s owner=%s mode=%s registered-keys=%s\n' "$target" "$owner_group" "$mode" "$key_count"
