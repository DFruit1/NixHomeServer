set -euo pipefail

username="${1:-}"
device_id="${2:-}"
if ! @NIX_GNUGREP@/bin/grep -Eq '^[a-z][a-z0-9._-]{0,63}$' <<<"$username"; then
  echo "invalid username" >&2
  exit 1
fi
if ! @NIX_GNUGREP@/bin/grep -Eq '^[A-Z2-7]{7}(-[A-Z2-7]{7}){7}$' <<<"$device_id"; then
  echo "invalid Syncthing device ID" >&2
  exit 1
fi

state_dir=@NIX_OFFLINEMEDIASTATEDIR_QUOTED@
state_file=@NIX_OFFLINEMEDIASTATEFILE_QUOTED@
folder_specs_json=@NIX_OFFLINEMEDIAFOLDERSPECSJSON_QUOTED@

install -d -m 0750 -o root -g root "$state_dir"
exec 9>"$state_dir/.devices.lock"
@NIX_UTIL_LINUX@/bin/flock -x 9
if [[ ! -f "$state_file" ]]; then
  state_init_tmp="$(@NIX_COREUTILS@/bin/mktemp "$state_dir/.devices.XXXXXX")"
  if ! @NIX_COREUTILS@/bin/printf '{"version":2,"users":{}}\n' > "$state_init_tmp" \
    || ! @NIX_JQ@/bin/jq -e '@NIX_OFFLINEMEDIASTATEVALIDATIONJQ@' "$state_init_tmp" >/dev/null \
    || ! @NIX_COREUTILS@/bin/chmod 0640 "$state_init_tmp" \
    || ! @NIX_COREUTILS@/bin/chown root:root "$state_init_tmp" \
    || ! @NIX_COREUTILS@/bin/mv "$state_init_tmp" "$state_file"; then
    @NIX_COREUTILS@/bin/rm -f "$state_init_tmp"
    echo "unable to initialize offline media enrollment state" >&2
    exit 1
  fi
fi
if ! @NIX_JQ@/bin/jq -e '@NIX_OFFLINEMEDIASTATEVALIDATIONJQ@' "$state_file" >/dev/null; then
  echo "offline media enrollment state is invalid; refusing to change Syncthing" >&2
  exit 1
fi

api_key_file="$(@NIX_COREUTILS@/bin/mktemp)"
headers_file="$(@NIX_COREUTILS@/bin/mktemp)"
trap 'rm -f "$api_key_file" "$headers_file"' EXIT
@NIX_LIBXML2@/bin/xmllint \
  --xpath 'string(configuration/gui/apikey)' \
  @NIX_SYNCTHINGCONFIGDIR_QUOTED@/config.xml \
  >"$api_key_file"
{ @NIX_COREUTILS@/bin/printf 'X-API-Key: '; @NIX_COREUTILS@/bin/cat "$api_key_file"; } >"$headers_file"

api() {
  local path="$1"
  shift
  @NIX_CURL@/bin/curl -fsSLk \
    -H "@$headers_file" \
    "$@" \
    "http://127.0.0.1:8384$path"
}

api_json() {
  local method="$1"
  local path="$2"
  local json="$3"

  @NIX_COREUTILS@/bin/printf '%s' "$json" | @NIX_CURL@/bin/curl -fsSLk \
    -X "$method" \
    -H "@$headers_file" \
    -H 'content-type: application/json' \
    --data-binary @- \
    "http://127.0.0.1:8384$path" >/dev/null
}

api /rest/system/ping >/dev/null

while IFS=$'\t' read -r folder_id_prefix; do
  folder_id="$folder_id_prefix-$username"
  folders_json="$(api /rest/config/folders)"
  if ! @NIX_JQ@/bin/jq -e --arg folderId "$folder_id" 'any(.[]; .id == $folderId)' >/dev/null <<<"$folders_json"; then
    continue
  fi
  if ! @NIX_JQ@/bin/jq -e --arg folderId "$folder_id" --arg deviceId "$device_id" \
      'any(.[] | select(.id == $folderId) | (.devices // [])[]?; .deviceID == $deviceId)' \
      <<<"$folders_json" >/dev/null; then
    continue
  fi
  folder_json="$(
    @NIX_JQ@/bin/jq \
      --arg folderId "$folder_id" \
      --arg deviceId "$device_id" \
      '(.[] | select(.id == $folderId))
      | .devices = ((.devices // []) | map(select(.deviceID != $deviceId)))' \
      <<<"$folders_json"
  )"
  api_json POST /rest/config/folders "$folder_json"
done < <(@NIX_JQ@/bin/jq -r '.[] | [.folderIdPrefix] | @tsv' <<<"$folder_specs_json")

remaining_refs="$(api /rest/config/folders | @NIX_JQ@/bin/jq --arg deviceId "$device_id" '[.[].devices[]? | select(.deviceID == $deviceId)] | length')"
if [[ "$remaining_refs" == "0" ]]; then
  devices_json="$(api /rest/config/devices)"
  if @NIX_JQ@/bin/jq -e --arg deviceId "$device_id" \
      'any(.[]; .deviceID == $deviceId)' <<<"$devices_json" >/dev/null; then
    api /rest/config/devices/"$device_id" -X DELETE >/dev/null
  fi
fi

tmp="$(@NIX_COREUTILS@/bin/mktemp "$state_dir/.devices.XXXXXX")"
@NIX_JQ@/bin/jq \
  --arg username "$username" \
  --arg deviceId "$device_id" \
  --arg updatedAt "$(@NIX_COREUTILS@/bin/date -u +%Y-%m-%dT%H:%M:%SZ)" \
  '
  def v2:
    if .version == 2 then .
    else {
      version: 2,
      users: (
        to_entries
        | map(select((.value.deviceId // "") != ""))
        | map({
          key: .key,
          value: {
            devices: [{
              deviceId: .value.deviceId,
              deviceName: (.value.deviceName // (.key + "-media")),
              createdAt: (.value.updatedAt // $updatedAt),
              updatedAt: (.value.updatedAt // $updatedAt)
            }]
          }
        })
        | from_entries
      )
    }
    end;
  v2
  | .version = 2
  | .users[$username].devices = ((.users[$username].devices // []) | map(select(.deviceId != $deviceId)))
  | if (.users[$username].devices | length) == 0 then del(.users[$username]) else . end
  ' \
  "$state_file" > "$tmp"
chmod 0640 "$tmp"
chown root:root "$tmp"
mv "$tmp" "$state_file"

if api /rest/config/restart-required | @NIX_JQ@/bin/jq -e '.requiresRestart == true' >/dev/null; then
  @NIX_SYSTEMD@/bin/systemctl restart syncthing.service
fi

status_json="$(@NIX_OFFLINEMEDIASTATUS@ "$username")"
@NIX_JQ@/bin/jq -n \
  --arg username "$username" \
  --arg removedDeviceId "$device_id" \
  --argjson status "$status_json" \
  '{
    ok: true,
    username: $username,
    removedDeviceId: $removedDeviceId,
    folders: $status.folders,
    devices: $status.devices
  }'
