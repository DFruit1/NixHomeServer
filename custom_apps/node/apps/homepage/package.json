{
  "name": "homepage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "prebuild": "pnpm run sync-shared",
    "build": "pnpm run build:client && pnpm run build:server",
    "build:client": "vite build",
    "build:server": "vite build -c adapters/node-server/vite.config.ts",
    "check": "pnpm run typecheck && pnpm run test",
    "pretest": "pnpm run sync-shared",
    "test": "vitest run",
    "pretypecheck": "pnpm run sync-shared",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "sync-shared": "mkdir -p src/shared/node-common && cp -r ../../shared/. src/shared/node-common/ 2>/dev/null || true"
  },
  "dependencies": {
    "@builder.io/qwik": "1.20.1",
    "@builder.io/qwik-city": "1.20.1",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/qrcode": "1.5.6",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
