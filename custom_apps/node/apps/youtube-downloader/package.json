{
  "name": "youtube-downloader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "prebuild": "pnpm run sync-shared",
    "build": "pnpm run build:client && pnpm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "dev": "vite",
    "tauri": "cargo tauri",
    "dev:tauri": "cargo tauri dev",
    "build:tauri": "cargo tauri build",
    "check": "pnpm run typecheck && pnpm run test",
    "pretest": "pnpm run sync-shared",
    "test": "vitest run",
    "pretypecheck": "pnpm run sync-shared",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "sync-shared": "mkdir -p src/shared/node-common && cp -r ../../shared/. src/shared/node-common/ 2>/dev/null || true"
  },
  "dependencies": {
    "@builder.io/qwik": "1.16.0"
  },
  "devDependencies": {
    "@types/node": "24.10.3",
    "typescript": "5.9.3",
    "vite": "7.3.0",
    "vitest": "4.0.15"
  }
}
