{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "File Sync",
  "version": "0.1.10",
  "identifier": "org.nixhomeserver.filesync",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5181",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "File Sync",
        "width": 980,
        "height": 760,
        "minWidth": 360,
        "minHeight": 520
      }
    ],
    "security": { "csp": null }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["filesync"] },
      "mobile": [{ "scheme": ["filesync"], "appLink": false }]
    }
  },
  "bundle": { "active": true, "targets": "all" }
}
