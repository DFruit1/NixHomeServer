#!/usr/bin/env bash
# Offline double for the D38 installed CLI entrypoint.
#
# It never starts a real Hermes client, never reads a profile config and never
# contacts anything. It records the exact argv and HERMES_HOME it was invoked
# with, so the suite can assert that the frozen body-free getter invocation —
# and only that invocation — reached the entrypoint.
#
# Environment:
#   COHESIVE_STUB_CLI_LOG     file to append the received argv to (required)
#   COHESIVE_STUB_CLI_COUNT   file incremented per invocation (required)
#   COHESIVE_STUB_CLI_OUTPUT  file whose bytes are the getter stdout
#   COHESIVE_STUB_CLI_STDERR  line emitted on stderr
#   COHESIVE_STUB_CLI_EXIT    exit code (default 0)
#   COHESIVE_STUB_CLI_SLEEP   seconds to sleep before emitting (deadline tests)

set -u

log_file="${COHESIVE_STUB_CLI_LOG:?COHESIVE_STUB_CLI_LOG is required}"
count_file="${COHESIVE_STUB_CLI_COUNT:?COHESIVE_STUB_CLI_COUNT is required}"

printf 'argc=%s\n' "$#" >>"$log_file"
for arg in "$@"; do
  printf 'arg=%s\n' "$arg" >>"$log_file"
done
printf 'hermes_home=%s\n' "${HERMES_HOME:-}" >>"$log_file"
printf 'x' >>"$count_file"

if [[ -n "${COHESIVE_STUB_CLI_SLEEP:-}" ]]; then
  sleep "$COHESIVE_STUB_CLI_SLEEP"
fi

if [[ -n "${COHESIVE_STUB_CLI_STDERR:-}" ]]; then
  printf '%s\n' "$COHESIVE_STUB_CLI_STDERR" >&2
fi

if [[ -n "${COHESIVE_STUB_CLI_OUTPUT:-}" ]]; then
  cat -- "$COHESIVE_STUB_CLI_OUTPUT"
fi

exit "${COHESIVE_STUB_CLI_EXIT:-0}"
