#!/usr/bin/env bash
# Offline transport double for the LWRACQ metrics-availability suite.
#
# It never touches the network and never runs a real ss/ssh. It replays a
# synthetic framed response that mirrors the frozen remote script in
# readiness-evidence/metrics-availability.sh: the frame header, then the
# already server-side-filtered payload, then the two pipeline exits. The suite
# separately asserts that the real remote command it receives contains that
# same frame header, the frozen timeouts and the frozen endpoint.
#
# Environment:
#   LWRACQ_STUB_LOG           file to append the received argv to (required)
#   LWRACQ_STUB_COUNT         file incremented per invocation (required)
#   LWRACQ_STUB_PAYLOAD       file whose lines are the filtered payload
#   LWRACQ_STUB_CURL_EXIT     curl exit to report (default 0)
#   LWRACQ_STUB_FILTER_EXIT   grep exit to report (default 0)
#   LWRACQ_STUB_SSH_EXIT      ssh-level exit; nonzero emits no frame
#   LWRACQ_STUB_BANNER        line emitted before the frame header
#   LWRACQ_STUB_STDERR        line emitted on stderr
#   LWRACQ_STUB_SLEEP         seconds to sleep before emitting (deadline tests)
#   LWRACQ_STUB_OMIT_STATUS   curl_exit | filter_exit | both, to truncate the frame

set -u

log_file="${LWRACQ_STUB_LOG:?LWRACQ_STUB_LOG is required}"
count_file="${LWRACQ_STUB_COUNT:?LWRACQ_STUB_COUNT is required}"

printf 'argc=%s\n' "$#" >>"$log_file"
for arg in "$@"; do
  printf 'arg=%s\n' "$arg" >>"$log_file"
done
printf 'x' >>"$count_file"

if [[ -n "${LWRACQ_STUB_SLEEP:-}" ]]; then
  sleep "$LWRACQ_STUB_SLEEP"
fi

if [[ -n "${LWRACQ_STUB_STDERR:-}" ]]; then
  printf '%s\n' "$LWRACQ_STUB_STDERR" >&2
fi

if [[ -n "${LWRACQ_STUB_SSH_EXIT:-}" ]]; then
  exit "$LWRACQ_STUB_SSH_EXIT"
fi

if [[ -n "${LWRACQ_STUB_BANNER:-}" ]]; then
  printf '%s\n' "$LWRACQ_STUB_BANNER"
fi

printf '%s\n' 'LWRACQ-METRICS-V1'

if [[ -n "${LWRACQ_STUB_PAYLOAD:-}" ]]; then
  while IFS= read -r line || [[ -n "$line" ]]; do
    printf '%s\n' "$line"
  done <"$LWRACQ_STUB_PAYLOAD"
fi

omit="${LWRACQ_STUB_OMIT_STATUS:-}"
if [[ "$omit" != 'curl_exit' && "$omit" != 'both' ]]; then
  printf 'curl_exit=%s\n' "${LWRACQ_STUB_CURL_EXIT:-0}"
fi
if [[ "$omit" != 'filter_exit' && "$omit" != 'both' ]]; then
  printf 'filter_exit=%s\n' "${LWRACQ_STUB_FILTER_EXIT:-0}"
fi

exit 0
